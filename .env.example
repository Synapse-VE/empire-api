# Goodgame Empire account used by the bridge.
# Use a test/dedicated account; auto-registration is disabled.
GGE_USERNAME=change-me
GGE_PASSWORD=change-me

# HIS1 = EmpireEx_25. By default only the configured zone(s) are logged in.
GGE_ZONE=EmpireEx_25
# GGE_ZONES=EmpireEx_25
# Opt-in: 1 = log into every GGE zone (or use GGE_ZONES=*).
# GGE_SERVER_URL must be empty in this mode.
GGE_ALL_SERVERS=0

# Optional: skip the network XML lookup and use a fixed server URL.
# GGE_SERVER_URL=wss://ep-live-his1-game.goodgamestudios.com/
# GGE_NETWORK_ID=
# GGE_NETWORK_IDS=1,5,11,26,34,39,64,65,68

# Locale used in the login payload.
GGE_LANG=fr

# Auth: every command request must start with /<API_PATH_SECRET>/<zone>/...
# Leave empty only for local/private Docker. Use a long random string.
API_PATH_SECRET=change-me-to-a-long-random-string
# Optional header auth for clients that can send it.
# API_KEY=change-me

# How long to wait for a game response (ms).
GGE_RESPONSE_TIMEOUT_MS=10000
# 1 = log frames with secrets redacted; 0 = quiet.
GGE_DEBUG=0
# E4K is not used for HIS1.
GGE_E4K=0

PORT=3000
